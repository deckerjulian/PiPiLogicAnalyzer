;--------------------------------------------------------------------------------------------
.program BLAST_CAPTURE

LOOP:

    jmp pin LOOP                ;wait for trigger

.wrap_target

    in pins 32                  ;capture

.wrap

;--------------------------------------------------------------------------------------------
.program STREAM_CAPTURE
;Stream capture: samples without end, the host stops it

.wrap_target

    in pins 32                  ;capture

.wrap

;--------------------------------------------------------------------------------------------
.program STREAM_TEST
;Test pattern of the stream capture instead of the inputs: a counter running down from 0,
;one value every two cycles

.wrap_target
START:

    in x 32                     ;sample = counter
    jmp x-- START               ;count down (at 0 the wrap continues at START as well)

.wrap

;--------------------------------------------------------------------------------------------
.program SEQUENCE_CAPTURE
;Trigger sequence capture (trigger type 7), timing mode: samples without end into the ring
;buffer while the CPU evaluates the sequence. Y counts the samples down from 0xFFFFFFFF; X is the
;stop value, the bit-inverted number of samples to take, which the CPU sends through the TX FIFO
;(PULL NOBLOCK keeps X while the FIFO is empty). The program stops exactly after that sample and
;sets IRQ 0. 5 cycles per sample.

    mov y, ~null                ;sample counter

SAMPLE:

    in pins 32                  ;capture
    pull noblock                ;new stop value from the CPU, or X again
    mov x, osr
    jmp y-- COUNTED             ;count the sample
COUNTED:
    jmp x!=y SAMPLE             ;more samples?

    irq 0                       ;notify the CPU that the capture is complete

LOCK:

    jmp LOCK                    ;block the program

;--------------------------------------------------------------------------------------------
.program STATE_CAPTURE
;State mode (trigger type 7 with an external clock): one sample on every active edge of the
;clock input. The clock is the IN pin with the index of the WAIT instructions (relative to
;INPUT_PIN_BASE); the firmware patches the index and, for the falling edge, the polarities.
;Counter and stop value like SEQUENCE_CAPTURE. The clock has to stay at the active level for at
;least 4 and at the inactive level for at least 3 cycles (system clock / 8 with 50% duty cycle).

    mov y, ~null                ;sample counter
    wait 0 pin 0                ;the first sample needs a complete edge

SAMPLE:

    wait 1 pin 0                ;active edge
    in pins 32                  ;capture
    pull noblock                ;new stop value from the CPU, or X again
    mov x, osr
    wait 0 pin 0                ;inactive level
    jmp y-- COUNTED             ;count the sample
COUNTED:
    jmp x!=y SAMPLE             ;more samples?

    irq 0                       ;notify the CPU that the capture is complete

LOCK:

    jmp LOCK                    ;block the program

;--------------------------------------------------------------------------------------------
.program POSITIVE_CAPTURE

    pull
    out y 32    		        ;read loop count
    pull
    mov x, osr                  ;read capture length (use MOV instead of PULL so we can MOV it again on each loop)

.wrap_target

    in pins 32			        ;read sample
    jmp pin POST_CAPTURE		;exit wrap if pin is set

.wrap

POST_CAPTURE:

    in pins 32			        ;read sample
    jmp x-- POST_CAPTURE		;loop if more samples needed

    jmp y-- LOOP                ;jump to loop control

    irq 0                       ;notify to the main program that we have finished capturing

LOCK:

    jmp LOCK                    ;block the program

LOOP:

    mov x, osr                  ;read loop count

INNER_LOOP:

    jmp pin POST_CAPTURE        ;wait for trigger
    jmp INNER_LOOP

;--------------------------------------------------------------------------------------------
.program NEGATIVE_CAPTURE

    pull
    out y 32    		        ;read loop count
    pull
    mov x, osr                  ;read capture length (use MOV instead of PULL so we can MOV it again on each loop)

PRE_CAPTURE:

    in pins 32			        ;read sample
    jmp pin PRE_CAPTURE		    ;loop if pin is set

POST_CAPTURE:

.wrap_target

    in pins 32			        ;read sample
    jmp x-- POST_CAPTURE		;loop if more samples needed

    jmp y-- LOOP                ;jump to loop control

    irq 0                       ;notify to the main program that we have finished capturing

LOCK:

    jmp LOCK                    ;block the program

LOOP:

    mov x, osr                  ;read loop count

INNER_LOOP:
    jmp pin INNER_LOOP          ;wait for trigger

.wrap

;--------------------------------------------------------------------------------------------
.program POSITIVE_CAPTURE_MEASUREBURSTS

    pull
    out y 32    		        ;read loop count
    pull
    mov x, osr                  ;read capture length (use MOV instead of PULL so we can MOV it again on each loop)
    irq wait 1                       ;trigger NMI to sync first timestamp

.wrap_target

    in pins 32			        ;read sample
    jmp pin POST_CAPTURE		;exit wrap if pin is set

.wrap

POST_CAPTURE:

    in pins 32			        ;read sample
    jmp x-- POST_CAPTURE		;loop if more samples needed

    jmp y-- LOOP                ;jump to loop control

    irq 1                       ;trigger NMI on the CPU to capture burst timestamp
    irq 0                       ;notify to the main program that we have finished capturing

LOCK:

    jmp LOCK                    ;block the program

LOOP:
    
    irq 1                       ;trigger NMI on the CPU to capture burst timestamp
    mov x, osr                  ;read loop count

INNER_LOOP:

    jmp pin POST_CAPTURE        ;wait for trigger
    jmp INNER_LOOP

;--------------------------------------------------------------------------------------------
.program NEGATIVE_CAPTURE_MEASUREBURSTS

    pull
    out y 32    		        ;read loop count
    pull
    mov x, osr                  ;read capture length (use MOV instead of PULL so we can MOV it again on each loop)
    irq wait 1                  ;trigger NMI to sync first timestamp

PRE_CAPTURE:

    in pins 32			        ;read sample
    jmp pin PRE_CAPTURE		    ;loop if pin is set

POST_CAPTURE:

.wrap_target

    in pins 32			        ;read sample
    jmp x-- POST_CAPTURE		;loop if more samples needed

    jmp y-- LOOP                ;jump to loop control

    irq 1                       ;trigger NMI on the CPU to capture burst timestamp
    irq 0                       ;notify to the main program that we have finished capturing

LOCK:

    jmp LOCK                    ;block the program

LOOP:

    irq 1                       ;trigger NMI on the CPU to capture burst timestamp
    mov x, osr                  ;read loop count

INNER_LOOP:
    jmp pin INNER_LOOP          ;wait for trigger

.wrap

;--------------------------------------------------------------------------------------------
.program COMPLEX_CAPTURE

    pull
    out x 32    		        ;read capture length

    wait irq 7                  ;wait for trigger program to be ready

.wrap_target

    in pins 32			        ;read sample
    jmp pin POST_CAPTURE		;exit wrap if pin is set

.wrap

POST_CAPTURE:

    in pins 32			        ;read sample
    jmp x-- POST_CAPTURE		;loop if more samples needed

    irq 0                       ;notify to the main program that we have finished capturing

LOCK:

    jmp LOCK                    ;block the program

;--------------------------------------------------------------------------------------------
.program FAST_CAPTURE

    pull
    out x 32    		        ;read capture length

.wrap_target

    in pins 32			        ;read sample
    jmp pin POST_CAPTURE		;exit wrap if pin is set

.wrap

POST_CAPTURE:

    in pins 32			        ;read sample
    jmp x-- POST_CAPTURE		;loop if more samples needed

    irq 0                       ;notify to the main program that we have finished capturing

LOCK:

    jmp LOCK                    ;block the program

